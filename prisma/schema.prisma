// Prisma Schema for Tractor Spare Parts ERP (MySQL Provider)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id            Int            @id @default(autoincrement()) @db.SmallInt
  name          String         @unique @db.VarChar(30)
  description   String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  users         User[]
  notifications Notification[]

  @@map("roles")
}

model Company {
  id        BigInt    @id @default(autoincrement())
  name      String    @unique @db.VarChar(120)
  status    String    @default("ACTIVE") @db.VarChar(10)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("companies")
}

model Category {
  id               BigInt     @id @default(autoincrement())
  name             String     @unique @db.VarChar(120)
  parentCategoryId BigInt?    @map("parent_category_id")
  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subCategories    Category[] @relation("CategoryHierarchy")
  status           String     @default("ACTIVE") @db.VarChar(10)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  products         Product[]

  @@map("categories")
}

model Unit {
  id        BigInt    @id @default(autoincrement())
  name      String    @unique @db.VarChar(30)
  shortCode String?   @map("short_code") @db.VarChar(10)
  products  Product[]

  @@map("units")
}

model DocumentSequence {
  id            BigInt   @id @default(autoincrement())
  docType       String   @map("doc_type") @db.VarChar(20)
  prefix        String   @db.VarChar(10)
  financialYear String   @map("financial_year") @db.VarChar(9)
  lastNumber    Int      @default(0) @map("last_number")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([docType, financialYear], name: "doc_type_financial_year_unique")
  @@map("document_sequences")
}

model User {
  id                  BigInt              @id @default(autoincrement())
  name                String              @db.VarChar(120)
  email               String              @unique @db.VarChar(150)
  phone               String?             @db.VarChar(15)
  passwordHash        String              @map("password_hash") @db.VarChar(255)
  roleId              Int                 @map("role_id") @db.SmallInt
  role                Role                @relation(fields: [roleId], references: [id])
  status              String              @default("ACTIVE") @db.VarChar(10)
  lastLoginAt         DateTime?           @map("last_login_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  refreshTokens       RefreshToken[]
  createdProducts     Product[]           @relation("ProductCreatedBy")
  inventoryMovements  InventoryMovement[] @relation("MovementCreatedBy")
  createdCustomers    Customer[]          @relation("CustomerCreatedBy")
  createdSales        Sale[]              @relation("SaleCreatedBy")
  finalizedSales      Sale[]              @relation("SaleFinalizedBy")
  cancelledSales      Sale[]              @relation("SaleCancelledBy")
  cancelledInvoices   Invoice[]           @relation("InvoiceCancelledBy")
  receivedPayments    Payment[]           @relation("PaymentReceivedBy")
  cancelledPayments   Payment[]           @relation("PaymentCancelledBy")
  ledgerEntries       CustomerLedger[]    @relation("LedgerCreatedBy")
  auditLogs           AuditLog[]
  targetNotifications Notification[]      @relation("UserNotification")

  @@map("users")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @map("token_hash") @db.VarChar(255)
  userAgent String?   @map("user_agent") @db.Text
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id                 BigInt              @id @default(autoincrement())
  productCode        String              @unique @map("product_code") @db.VarChar(30)
  name               String              @db.VarChar(150)
  partNumber         String              @unique @map("part_number") @db.VarChar(60)
  companyId          BigInt              @map("company_id")
  company            Company             @relation(fields: [companyId], references: [id])
  categoryId         BigInt              @map("category_id")
  category           Category            @relation(fields: [categoryId], references: [id])
  unitId             BigInt              @map("unit_id")
  unit               Unit                @relation(fields: [unitId], references: [id])
  description        String?             @db.Text
  purchasePrice      Decimal             @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice       Decimal             @map("selling_price") @db.Decimal(12, 2)
  gstPercent         Decimal             @default(0) @map("gst_percent") @db.Decimal(5, 2)
  minimumStock       Int                 @default(0) @map("minimum_stock")
  maximumStock       Int?                @map("maximum_stock")
  status             String              @default("ACTIVE") @db.VarChar(10)
  createdBy          BigInt?             @map("created_by")
  creator            User?               @relation("ProductCreatedBy", fields: [createdBy], references: [id])
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  inventory          Inventory?
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]

  @@index([name])
  @@index([companyId])
  @@index([categoryId])
  @@map("products")
}

model Inventory {
  id             BigInt    @id @default(autoincrement())
  productId      BigInt    @unique @map("product_id")
  product        Product   @relation(fields: [productId], references: [id])
  currentStock   Int       @default(0) @map("current_stock")
  lastMovementAt DateTime? @map("last_movement_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("inventory")
}

model InventoryMovement {
  id             BigInt   @id @default(autoincrement())
  productId      BigInt   @map("product_id")
  product        Product  @relation(fields: [productId], references: [id])
  movementType   String   @map("movement_type") @db.VarChar(30)
  quantityChange Int      @map("quantity_change")
  stockBefore    Int      @map("stock_before")
  stockAfter     Int      @map("stock_after")
  referenceType  String?  @map("reference_type") @db.VarChar(20)
  referenceId    BigInt?  @map("reference_id")
  remarks        String?  @db.Text
  createdBy      BigInt   @map("created_by")
  creator        User     @relation("MovementCreatedBy", fields: [createdBy], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@map("inventory_movements")
}

model Customer {
  id              BigInt           @id @default(autoincrement())
  customerCode    String           @unique @map("customer_code") @db.VarChar(30)
  name            String           @db.VarChar(150)
  mobile          String           @unique @db.VarChar(15)
  alternateMobile String?          @map("alternate_mobile") @db.VarChar(15)
  email           String?          @db.VarChar(150)
  address         String?          @db.Text
  gstNumber       String?          @map("gst_number") @db.VarChar(20)
  city            String?          @db.VarChar(100)
  state           String?          @db.VarChar(100)
  pincode         String?          @db.VarChar(10)
  openingBalance  Decimal          @default(0) @map("opening_balance") @db.Decimal(12, 2)
  creditLimit     Decimal?         @map("credit_limit") @db.Decimal(12, 2)
  status          String           @default("ACTIVE") @db.VarChar(10)
  createdBy       BigInt?          @map("created_by")
  creator         User?            @relation("CustomerCreatedBy", fields: [createdBy], references: [id])
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  sales           Sale[]
  payments        Payment[]
  ledgerEntries   CustomerLedger[]

  @@index([name])
  @@map("customers")
}

model Sale {
  id             BigInt     @id @default(autoincrement())
  saleNumber     String     @unique @map("sale_number") @db.VarChar(30)
  customerId     BigInt     @map("customer_id")
  customer       Customer   @relation(fields: [customerId], references: [id])
  saleDate       DateTime   @default(now()) @map("sale_date")
  saleStatus     String     @default("DRAFT") @map("sale_status") @db.VarChar(15)
  paymentStatus  String     @default("ROUGH") @map("payment_status") @db.VarChar(15)
  subtotal       Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @map("discount_amount") @db.Decimal(12, 2)
  cgstTotal      Decimal    @default(0) @map("cgst_total") @db.Decimal(12, 2)
  sgstTotal      Decimal    @default(0) @map("sgst_total") @db.Decimal(12, 2)
  igstTotal      Decimal    @default(0) @map("igst_total") @db.Decimal(12, 2)
  gstTotal       Decimal    @default(0) @map("gst_total") @db.Decimal(12, 2)
  roundOff       Decimal    @default(0) @map("round_off") @db.Decimal(6, 2)
  grandTotal     Decimal    @default(0) @map("grand_total") @db.Decimal(12, 2)
  paidAmount     Decimal    @default(0) @map("paid_amount") @db.Decimal(12, 2)
  pendingAmount  Decimal    @default(0) @map("pending_amount") @db.Decimal(12, 2)
  idempotencyKey String?    @unique @map("idempotency_key") @db.VarChar(80)
  createdBy      BigInt     @map("created_by")
  creator        User       @relation("SaleCreatedBy", fields: [createdBy], references: [id])
  finalizedBy    BigInt?    @map("finalized_by")
  finalizer      User?      @relation("SaleFinalizedBy", fields: [finalizedBy], references: [id])
  finalizedAt    DateTime?  @map("finalized_at")
  cancelledBy    BigInt?    @map("cancelled_by")
  canceller      User?      @relation("SaleCancelledBy", fields: [cancelledBy], references: [id])
  cancelledAt    DateTime?  @map("cancelled_at")
  cancelReason   String?    @map("cancel_reason") @db.Text
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  saleItems      SaleItem[]
  invoice        Invoice?
  payments       Payment[]

  @@index([customerId])
  @@index([saleStatus])
  @@index([paymentStatus])
  @@map("sales")
}

model SaleItem {
  id                  BigInt   @id @default(autoincrement())
  saleId              BigInt   @map("sale_id")
  sale                Sale     @relation(fields: [saleId], references: [id])
  productId           BigInt   @map("product_id")
  product             Product  @relation(fields: [productId], references: [id])
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(150)
  partNumberSnapshot  String   @map("part_number_snapshot") @db.VarChar(60)
  unitSnapshot        String   @map("unit_snapshot") @db.VarChar(30)
  quantity            Int
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 2)
  gstPercent          Decimal  @map("gst_percent") @db.Decimal(5, 2)
  cgstAmount          Decimal  @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount          Decimal  @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount          Decimal  @default(0) @map("igst_amount") @db.Decimal(12, 2)
  gstAmount           Decimal  @map("gst_amount") @db.Decimal(12, 2)
  discountAmount      Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  itemTotal           Decimal  @map("item_total") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([saleId])
  @@map("sale_items")
}

model Invoice {
  id                 BigInt              @id @default(autoincrement())
  saleId             BigInt              @unique @map("sale_id")
  sale               Sale                @relation(fields: [saleId], references: [id])
  invoiceNumber      String              @unique @map("invoice_number") @db.VarChar(40)
  invoiceDate        DateTime            @default(now()) @map("invoice_date")
  status             String              @default("FINALIZED") @db.VarChar(15)
  shopSnapshot       Json                @map("shop_snapshot")
  customerSnapshot   Json                @map("customer_snapshot")
  subtotal           Decimal             @db.Decimal(12, 2)
  gstTotal           Decimal             @map("gst_total") @db.Decimal(12, 2)
  discountTotal      Decimal             @map("discount_total") @db.Decimal(12, 2)
  grandTotal         Decimal             @map("grand_total") @db.Decimal(12, 2)
  paidAmount         Decimal             @map("paid_amount") @db.Decimal(12, 2)
  pendingAmount      Decimal             @map("pending_amount") @db.Decimal(12, 2)
  cancelledBy        BigInt?             @map("cancelled_by")
  canceller          User?               @relation("InvoiceCancelledBy", fields: [cancelledBy], references: [id])
  cancelledAt        DateTime?           @map("cancelled_at")
  cancelReason       String?             @map("cancel_reason") @db.Text
  createdAt          DateTime            @default(now()) @map("created_at")
  paymentAllocations PaymentAllocation[]

  @@map("invoices")
}

model Payment {
  id             BigInt              @id @default(autoincrement())
  paymentNumber  String              @unique @map("payment_number") @db.VarChar(30)
  saleId         BigInt              @map("sale_id")
  sale           Sale                @relation(fields: [saleId], references: [id])
  customerId     BigInt              @map("customer_id")
  customer       Customer            @relation(fields: [customerId], references: [id])
  amount         Decimal             @db.Decimal(12, 2)
  paymentMethod  String              @map("payment_method") @db.VarChar(20)
  status         String              @default("COMPLETED") @db.VarChar(15)
  referenceNote  String?             @map("reference_note") @db.VarChar(150)
  receivedBy     BigInt              @map("received_by")
  receiver       User                @relation("PaymentReceivedBy", fields: [receivedBy], references: [id])
  paymentDate    DateTime            @default(now()) @map("payment_date")
  idempotencyKey String?             @unique @map("idempotency_key") @db.VarChar(80)
  cancelledBy    BigInt?             @map("cancelled_by")
  canceller      User?               @relation("PaymentCancelledBy", fields: [cancelledBy], references: [id])
  cancelledAt    DateTime?           @map("cancelled_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  allocations    PaymentAllocation[]

  @@index([saleId])
  @@map("payments")
}

model PaymentAllocation {
  id              BigInt   @id @default(autoincrement())
  paymentId       BigInt   @map("payment_id")
  payment         Payment  @relation(fields: [paymentId], references: [id])
  invoiceId       BigInt   @map("invoice_id")
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([paymentId, invoiceId])
  @@map("payment_allocations")
}

model CustomerLedger {
  id             BigInt   @id @default(autoincrement())
  customerId     BigInt   @map("customer_id")
  customer       Customer @relation(fields: [customerId], references: [id])
  entryType      String   @map("entry_type") @db.VarChar(20)
  referenceType  String?  @map("reference_type") @db.VarChar(20)
  referenceId    BigInt?  @map("reference_id")
  debitAmount    Decimal  @default(0) @map("debit_amount") @db.Decimal(12, 2)
  creditAmount   Decimal  @default(0) @map("credit_amount") @db.Decimal(12, 2)
  runningBalance Decimal  @map("running_balance") @db.Decimal(12, 2)
  description    String?  @db.Text
  createdBy      BigInt?  @map("created_by")
  creator        User?    @relation("LedgerCreatedBy", fields: [createdBy], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@map("customer_ledger")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String   @db.VarChar(50)
  module    String   @db.VarChar(30)
  recordId  BigInt?  @map("record_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([module, recordId])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id           BigInt   @id @default(autoincrement())
  key          String   @unique @db.VarChar(80)
  endpoint     String   @db.VarChar(100)
  requestHash  String   @map("request_hash") @db.VarChar(64)
  responseBody Json?    @map("response_body")
  statusCode   Int?     @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@map("idempotency_keys")
}

model Notification {
  id            BigInt   @id @default(autoincrement())
  type          String   @db.VarChar(30)
  title         String   @db.Text
  message       String   @db.Text
  referenceType String?  @map("reference_type") @db.VarChar(50)
  referenceId   BigInt?  @map("reference_id")
  targetRoleId  Int?     @map("target_role_id") @db.SmallInt
  targetRole    Role?    @relation(fields: [targetRoleId], references: [id])
  targetUserId  BigInt?  @map("target_user_id")
  targetUser    User?    @relation("UserNotification", fields: [targetUserId], references: [id])
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("notifications")
}
