# -------------------------------------------------------------
# Tractor ERP Docker Production Environment Variables
# -------------------------------------------------------------

# Port on the Oracle Instance host mapped to the ERP backend
API_PORT=5003

# Host port for MySQL (mapped to 3307 so it doesn't conflict with host 3306)
DB_HOST_PORT=3307

# Database credentials (used inside Docker network)
DB_NAME=tractor_erp
DB_USER=tractor_user
DB_PASSWORD=SetAStrongPasswordHere123!
DB_ROOT_PASSWORD=SetAStrongRootPasswordHere123!

# JWT Secrets for Authentication
JWT_SECRET=super-secret-jwt-key-tractor-erp-production-random-hash-2026
JWT_REFRESH_SECRET=super-secret-refresh-key-tractor-erp-production-random-hash-2026
LOG_LEVEL=info
