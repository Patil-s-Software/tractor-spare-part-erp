PORT=5000
NODE_ENV=development

# ── Database – set each part separately (password auto URL-encoded) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=tractor_erp

# Optional: override everything above with a direct connection string
# DATABASE_URL="mysql://root:your_password@localhost:3306/tractor_erp"

JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
LOG_LEVEL=info
